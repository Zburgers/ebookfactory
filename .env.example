# Local peer-authenticated PostgreSQL target provisioned by the owner.
EBOOK_FACTORY_ENV=local
EBOOK_FACTORY_DATABASE_URL=postgresql+psycopg://naki@/ebookfactory?host=/var/run/postgresql
EBOOK_FACTORY_ARTIFACT_ROOT=./var/artifacts
# Required only for private supervisor callbacks; keep it local and untracked.
EBOOK_FACTORY_WORKER_TOKEN=
